APP_NAME="Text RPG Bot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_DATABASE is absolute path in production if needed; default: database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Same-origin media URLs for admin (default /storage). Absolute CDN URL if needed.
# FILESYSTEM_PUBLIC_URL=/storage
# Local/Herd: sync + file OK; idle session delay → connection=database
# (composer dev поднимает queue:listen database). Production: redis.
QUEUE_CONNECTION=sync
CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Bot API via App\Support\Telegram\TelegramClient (Laravel Http). Dev and prod are different bots/tokens.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Empty = long polling (`php artisan telegram:poll`). Set = webhook only (poll refuses).
# Prod example: https://your-domain.example/telegram/webhook
TELEGRAM_WEBHOOK_URL=
# Required when webhook URL is set; sent as X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# true only in production (Redis queue). Local: false.
TELEGRAM_ASYNC=false

# Filament admin seeder (database/seeders/AdminUserSeeder.php)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
